<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Notice when the connection is back, so “no connection” screens reload by themselves. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- WorkManager declares this for foreground workers; the app has none. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" tools:node="remove" />
    <!-- Supernova notifications (asked for only when the user turns them on). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 17+: a bookmark service in the home network (asked for only when its address is a local one). -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <!-- Custom Tabs: find browsers that support them (Android 11+ package visibility). -->
    <queries>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
    </queries>

    <application
        android:name=".PlanetFossApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.PlanetFOSS"
>

        <!-- WebView: no usage metrics to Google (opt-out applies even if the user agreed system-wide),
             Safe Browsing off from the first page on (it sends URL hashes to Google). -->
        <meta-data android:name="android.webkit.WebView.MetricsOptOut" android:value="true" />
        <meta-data android:name="android.webkit.WebView.EnableSafeBrowsing" android:value="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Notification taps: planetfoss://supernova/<key>. Not BROWSABLE: web pages cannot start it. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="planetfoss" />
                <data android:host="supernova" />
                <data android:host="topic" />
            </intent-filter>
        </activity>

        <service android:name="androidx.work.impl.foreground.SystemForegroundService" tools:node="remove" />

        <!-- WorkManager is configured by PlanetFossApp (Hilt workers), not by its startup initializer. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
        <!-- Home screen widgets (Glance): the logbook and Radar, 6.11.2026 -->
        <receiver android:name=".widget.LogbookWidgetReceiver" android:exported="true" android:label="@string/widget_logbook_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_logbook" />
        </receiver>
        <receiver android:name=".widget.RadarWidgetReceiver" android:exported="true" android:label="@string/widget_radar_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_radar" />
        </receiver>
    </application>
</manifest>
